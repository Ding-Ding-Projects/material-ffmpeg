{
  "name": "material-ffmpeg",
  "productName": "material-ffmpeg",
  "version": "0.1.0",
  "description": "Local Material 3 desktop control plane for FFmpeg with typed workflows, inspection, and job management.",
  "main": "src/main.js",
  "author": "Ding-Ding-Projects",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "fetch:dependencies": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/download-dependencies.ps1 -Silent",
    "icon": "node scripts/generate-app-icon.mjs",
    "metadata": "node scripts/write-build-metadata.mjs",
    "prepare:package": "node scripts/clean-output.mjs && npm run icon && npm run metadata && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/download-ffmpeg.ps1 -Silent",
    "prepackage:app": "npm run prepare:package",
    "package:app": "electron-builder --dir --win",
    "predist": "npm run prepare:package",
    "dist": "electron-builder --win squirrel",
    "count:lines": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/count-lines.ps1"
  },
  "devDependencies": {
    "7zip-bin": "5.2.0",
    "electron": "33.4.11",
    "electron-builder": "26.15.3",
    "electron-builder-squirrel-windows": "26.15.3"
  },
  "build": {
    "appId": "dev.dingding.material-ffmpeg",
    "productName": "material-ffmpeg",
    "forceCodeSigning": false,
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/ffmpeg",
        "to": "ffmpeg",
        "filter": ["**/*"]
      },
      {
        "from": "resources/build-metadata.json",
        "to": "build-metadata.json"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "squirrel",
      "icon": "resources/app-icon.ico",
      "signExecutable": false,
      "signAndEditExecutable": false
    },
    "squirrelWindows": {
      "artifactName": "material-ffmpeg-setup-${version}.exe",
      "iconUrl": "https://raw.githubusercontent.com/Ding-Ding-Projects/material-ffmpeg/main/resources/app-icon.ico",
      "msi": false
    }
  }
}
